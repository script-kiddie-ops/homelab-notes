# Эталонный фрагмент /etc/pve/lxc/<VMID>.conf для LLM-GPU CT.
# Источник правды для propagate-conf-from-template.sh
# VMID-специфичные поля (net0, hostname, rootfs) — НЕ включать.
#
# Major cgroup: сверить на хосте: ls -l /dev/nvidia*
# Зафиксировано для PVE + driver 595.x (2026-05): 195 (nvidia*), 507 (nvidia-uvm*)

arch: amd64
cores: 8
features: nesting=1
hookscript: local:snippets/gpu-mutex.sh
memory: 65536
mp0: /mnt/llm-shared,mp=/srv/llm
ostype: ubuntu
swap: 8192
tags: llm-gpu-base
lxc.mount.entry: /dev/nvidia0 dev/nvidia0 none bind,optional,create=file
lxc.mount.entry: /dev/nvidiactl dev/nvidiactl none bind,optional,create=file
lxc.mount.entry: /dev/nvidia-modeset dev/nvidia-modeset none bind,optional,create=file
lxc.mount.entry: /dev/nvidia-uvm dev/nvidia-uvm none bind,optional,create=file
lxc.mount.entry: /dev/nvidia-uvm-tools dev/nvidia-uvm-tools none bind,optional,create=file
lxc.cgroup2.devices.allow: c 195:* rwm
lxc.cgroup2.devices.allow: c 507:* rwm
