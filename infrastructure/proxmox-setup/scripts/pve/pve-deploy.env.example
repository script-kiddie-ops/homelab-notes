# Скопировать на PVE как ~/llm-gpu-setup/pve-deploy.env (не коммитить).
# На бою подставьте реальные значения (см. private/map).

ZFS_POOL=netacA
LLM_PVE_HOME=/home/guests
LLM_SSH_USER=guests
LLM_SSH_PORT=1234

# Deploy CT (defaults for --engine ollama → VMID 102)
DEPLOY_VMID=102
DEPLOY_HOSTNAME=guests-ollama-ct
DEPLOY_IP=10.x.x.102/24
DEPLOY_GW=10.x.x.1
# Legacy aliases (deploy-llm-ct.sh reads both):
OLLAMA_HOSTNAME=guests-ollama-ct
OLLAMA_IP=10.x.x.102/24
OLLAMA_GW=10.x.x.1
